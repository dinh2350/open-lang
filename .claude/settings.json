{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-lint-edited-file.ts\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
