# Copy to .env (git-ignored). Docker Compose and the `pnpm sonar*` scripts
# read it; see docs/quality-gates.md for SonarQube. Each checkout has its
# own .env.

# Host port of the Compose Postgres. Change it when another Postgres already
# listens on 5432, and change DATABASE_URL in backend/.env to match.
POSTGRES_PORT=5432

SONAR_HOST_URL=http://localhost:9000

# `pnpm sonar:setup` changes SonarQube's default admin password to this one.
# SonarQube only listens on 127.0.0.1. Every checkout must use the same
# value, since all of them share one SonarQube.
SONAR_ADMIN_PASSWORD=Local-Sonar-Admin-1

# `pnpm sonar:setup` writes this checkout's analysis token here.
SONAR_TOKEN=

# MCP servers (.mcp.json). Claude Code does not read this file: set these in
# your shell or in .claude/settings.local.json (git-ignored) under "env".
# `github`: fine-grained PAT, read-only, limited to this repository.
GITHUB_PERSONAL_ACCESS_TOKEN=
# `dbhub`: connection string of the Compose Postgres, matching backend/.env.
# Use a database user that only has SELECT rights.
DBHUB_DSN=
