{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.7.3"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@0.0.86", "--isolated"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.13.0", "--no-usage-statistics"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "livekit-docs": {
      "type": "http",
      "url": "https://docs.livekit.io/mcp"
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@microsoft/postgres-mcp@0.3.1", "run", "--no-telemetry"]
    }
  }
}
