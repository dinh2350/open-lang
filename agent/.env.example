# Copy to .env (git-ignored) and adjust. These defaults match the local
# Docker Compose LiveKit server in dev mode.

LIVEKIT_URL=ws://localhost:7880
# LiveKit dev mode uses the fixed key "devkey" and secret "secret".
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# The Agent only joins rooms whose Room Token dispatches this name.
# Must match the backend's AGENT_NAME.
AGENT_NAME=livekit-platform-agent

# Agent Mode: "realtime" (one model listens and speaks) or "pipeline"
# (separate models transcribe, think and speak).
AGENT_MODE=realtime

# Realtime mode.
# Provider: "openai", or "fake" (no AI calls, no API key; the Agent joins and
# stays silent). To talk with the Agent, set "openai" and fill in
# OPENAI_API_KEY.
REALTIME_PROVIDER=fake
# Optional. Empty means the default: gpt-realtime-2.1 for OpenAI. The fake
# Provider ignores it. The Agent refuses to start with a deprecated model.
REALTIME_MODEL=
# Optional. Empty means the default: marin for OpenAI.
REALTIME_VOICE=

# Pipeline mode. Each step has its own Provider, "openai" or "fake", and the
# Providers may be mixed. A fake step makes no AI calls: the fake speech-to-
# text hears nothing, the fake language model answers nothing, and the fake
# text-to-speech says nothing. Empty models mean the defaults. The Agent
# refuses to start with a deprecated model.
STT_PROVIDER=fake
# Default for OpenAI: gpt-live-transcribe.
STT_MODEL=
LLM_PROVIDER=fake
# Default for OpenAI: gpt-6-luna.
LLM_MODEL=
TTS_PROVIDER=fake
# Default for OpenAI: gpt-4o-mini-tts (OpenAI shuts it down on 2027-01-06).
TTS_MODEL=
# Optional. Empty means the default: marin for OpenAI.
TTS_VOICE=

# Required when any Provider is "openai". Never commit a real key.
OPENAI_API_KEY=
