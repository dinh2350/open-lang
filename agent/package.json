{
  "name": "@livekit-platform/agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --env-file-if-exists=.env src/main.ts dev",
    "start": "node --env-file-if-exists=.env src/main.ts start",
    "test:live": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config test/live/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "^1.10.0",
    "@livekit/agents-plugin-google": "^1.10.0",
    "@livekit/agents-plugin-openai": "^1.10.0",
    "@livekit/rtc-node": "^1.2.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@livekit/protocol": "^1.54.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
