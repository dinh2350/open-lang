# Copy to .env (git-ignored) and adjust. These defaults match the local
# Docker Compose LiveKit server in dev mode.

LIVEKIT_URL=ws://localhost:7880
# LiveKit dev mode uses the fixed key "devkey" and secret "secret".
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# The Agent only joins rooms whose Room Token dispatches this name.
# Must match the backend's AGENT_NAME.
AGENT_NAME=open-lang

# Agent Mode: "realtime" (one model listens and speaks) or "pipeline"
# (separate models transcribe, think and speak).
AGENT_MODE=realtime

# Realtime mode.
# Provider: "openai", "google", or "fake" (no AI calls, no API key; the Agent
# joins and stays silent). To talk with the Agent, set "openai" or "google"
# and fill in that Provider's credentials below.
REALTIME_PROVIDER=fake
# Optional. Empty means the default: gpt-realtime-2.1 for OpenAI,
# gemini-3.8-live for Google. The fake Provider ignores it. The Agent refuses
# to start with a deprecated model.
REALTIME_MODEL=
# Optional. Empty means the default: marin for OpenAI, Kore for Google.
REALTIME_VOICE=

# Pipeline mode. Each step has its own Provider, "openai", "google" or
# "fake", and the Providers may be mixed. A fake step makes no AI calls: the
# fake speech-to-text hears nothing, the fake language model answers nothing,
# and the fake text-to-speech says nothing. Empty models mean the defaults.
# The Agent refuses to start with a deprecated model.
STT_PROVIDER=fake
# Default for OpenAI: gpt-live-transcribe. For Google:
# gemini-3.5-transcribe-live.
STT_MODEL=
LLM_PROVIDER=fake
# Default for OpenAI: gpt-6-luna. For Google: gemini-3.8-flash.
LLM_MODEL=
TTS_PROVIDER=fake
# Default for OpenAI: gpt-4o-mini-tts (OpenAI shuts it down on 2027-01-06).
# For Google: gemini-3.8-flash-lite-tts.
TTS_MODEL=
# Optional. Empty means the default: marin for OpenAI, Kore for Google.
TTS_VOICE=

# Required when any Provider is "openai". Never commit a real key.
OPENAI_API_KEY=

# Google, when any Provider is "google". Either a Gemini API key:
GOOGLE_API_KEY=
# or Vertex AI: set "true" with a project and location, and sign in with
# Google's Application Default Credentials (for example `gcloud auth
# application-default login`, or GOOGLE_APPLICATION_CREDENTIALS). Vertex AI
# wins when both are set. The location "us" (or "eu") serves every default
# Google model; "us-central1" doesn't.
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us
