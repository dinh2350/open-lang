# Copy to .env (git-ignored) and adjust. These defaults match the local
# Docker Compose LiveKit server in dev mode.

# Port the backend listens on. The frontend's Vite proxy forwards /api here.
PORT=3000

# URL the browser uses to reach the LiveKit server.
LIVEKIT_URL=ws://localhost:7880
# LiveKit dev mode uses the fixed key "devkey" and secret "secret".
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Every Room Token dispatches the Agent with this name. Must match the Agent's AGENT_NAME.
AGENT_NAME=open-lang

# The Compose Postgres (`docker compose up`). If you moved it with
# POSTGRES_PORT in the root .env, use that port here.
DATABASE_URL=postgresql://open_lang:open_lang@localhost:5432/open_lang

# Signs Auth Tokens (HS256): at least 32 characters. Never commit it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# The key the Agent sends as `Authorization: Bearer` when it reports turns and
# Misses: at least 32 characters. The Agent's own AGENT_API_KEY must match.
# Never commit it. Generate one with: openssl rand -base64 48
AGENT_API_KEY=

# Which model writes the Reports: `fake` (the default, canned answers),
# `openai` or `google`.
REPORT_PROVIDER=fake
# The Provider's model. Blank uses the Agent's Pipeline default for the
# Provider: gpt-6-luna for openai, gemini-3.8-flash for google.
REPORT_MODEL=
# The Provider's API key: required when REPORT_PROVIDER is "openai" or "google"
# respectively, ignored otherwise. Never commit one.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# `pnpm db:seed` creates the first Admin with this email and password when
# no Admin exists yet. The password needs at least 12 characters; never
# commit it. Once an Admin exists, the seed changes nothing.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
