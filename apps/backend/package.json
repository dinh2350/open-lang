{
  "name": "@open-live-agent/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "nest start --exec \"node --env-file-if-exists=.env\"",
    "db:migrate": "prisma generate && prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "nest start --entryFile seed --exec \"node --env-file-if-exists=.env\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/throttler": "^6.7.1",
    "@open-live-agent/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "cookie": "^2.0.2",
    "livekit-server-sdk": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
