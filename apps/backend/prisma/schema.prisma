// The backend's data (ADR 0002). After a change, run `pnpm db:migrate` to
// create and apply a migration and regenerate the client.

generator client {
  provider            = "prisma-client"
  // Generated on install and by `pnpm db:migrate`; git-ignored.
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// What a User may do (GLOSSARY.md).
enum Role {
  member
  admin
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Stored lowercase, so it is unique whatever case the User types.
  email        String   @unique
  /// argon2id hash; the password itself is never stored.
  passwordHash String
  role          Role           @default(member)
  /// A Locked User can't sign in or call the backend (GLOSSARY.md).
  locked        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  conversations Conversation[]
}

/// Keeps a User signed in for 7 days without their password (ADR 0003).
/// Each refresh rotates it: the token is revoked, and a new one replaces it.
model RefreshToken {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String        @db.Uuid
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token. The token itself is only in the User's cookie.
  tokenHash  String        @unique
  expiresAt  DateTime
  /// When it was rotated, signed out, or revoked with all of the User's tokens.
  revokedAt  DateTime?
  /// The token this one replaced when that token was rotated.
  replacesId String?       @unique @db.Uuid
  replaces   RefreshToken? @relation("Rotation", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy RefreshToken? @relation("Rotation")
  createdAt  DateTime      @default(now())

  @@index([userId])
}

/// Which side of a Conversation spoke a Turn.
enum TurnRole {
  agent
  user
}

/// How far a Report has got.
enum ReportStatus {
  generating
  ready
  failed
}

/// One listening role-play of a User: created with the Room Token, in the room
/// it names.
model Conversation {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The LiveKit room of the Conversation, `conversation-<uuid>`.
  roomName   String   @unique
  scenarioId String
  /// How fast the Agent speaks: 0.7, 0.85 or 1.
  speed      Float
  createdAt  DateTime @default(now())
  /// When the Agent said it had sent every turn and Miss (the end marker);
  /// null while the Conversation runs, or when the Agent never said so.
  endedAt    DateTime?
  turns      Turn[]
  misses     Miss[]
  report     Report?

  @@index([userId, createdAt])
}

/// One thing said in a Conversation, by the Agent or the User.
model Turn {
  id             String       @id @default(uuid(7)) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// The id of the item in the Agent's chat context, so a Turn is stored once.
  itemId         String
  role           TurnRole
  text           String
  startedAt      DateTime
  endedAt        DateTime?

  @@unique([conversationId, itemId])
}

/// A press of "I did not catch that".
model Miss {
  id             String       @id @default(uuid(7)) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  pressedAt      DateTime

  @@index([conversationId])
}

/// The feedback on a finished Conversation.
model Report {
  conversationId String       @id @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         ReportStatus
  content        Json?
  startedAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
