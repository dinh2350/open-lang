# Copy to .env (git-ignored) and adjust.

# Backend the Vite dev server proxies /api to. Read by vite.config.ts only;
# it is not exposed to the browser.
BACKEND_URL=http://localhost:3000

# How long a Conversation waits for the Agent to join, in milliseconds,
# before it shows "Agent unavailable" and ends. Empty means 15000. Vite
# exposes VITE_ variables to the browser, so never put a secret in one.
VITE_AGENT_JOIN_TIMEOUT_MS=
